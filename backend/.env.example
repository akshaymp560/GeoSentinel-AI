# Use PostgreSQL in deployed/shared environments, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/geosentinel
# Local development/tests use this explicit SQLite fallback when DATABASE_URL is unset:
DATABASE_URL=sqlite:///./geosentinel.db

# Google Earth Engine Cloud Project used by gee_retriever.py.
# Authenticate separately using the official Earth Engine setup/CLI flow.
GEE_PROJECT=your-ee-cloud-project-id

# NASA FIRMS free MAP_KEY for area CSV requests.
# Request one through the official NASA FIRMS account workflow.
FIRMS_MAP_KEY=key
